# Copy to .env and fill in real values. .env is gitignored - never commit it.

POSTGRES_USER=dgl
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dgl
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

WEB_HOST=0.0.0.0
WEB_PORT=8080
SESSION_TTL_HOURS=12

# Bootstraps the initial super_admin account on first startup only (no-op if
# any super_admin already exists). Log in with these once, then create named
# accounts for everyone and stop using this one directly.
SUPERADMIN_USER=admin
SUPERADMIN_PASSWORD=change_me

# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts the Ed25519 license-signing private key at rest in the database.
# Back this up somewhere separate from the DB backup - losing it means
# losing the ability to issue licenses under the same key (the DB copy of
# the key is unrecoverable without it).
LICENSE_MASTER_KEY=

# SMTP for license-expiry warning emails. Gmail: smtp.gmail.com, port 587,
# an *app password* (not the account password) for SMTP_PASSWORD - see
# https://myaccount.google.com/apppasswords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated list of who gets the expiry warnings.
NOTIFY_TO=
NOTIFY_DAYS_BEFORE=30
